# Anthropic — advisor role (Claude Opus 5)
ANTHROPIC_API_KEY=

# DeepSeek — reasoning/implementation/research roles (OpenAI-compatible endpoint)
DEEPSEEK_API_KEY=

# Groq — fast role (free tier)
GROQ_API_KEY=

# Kaggle — dataset download + submission
KAGGLE_USERNAME=
KAGGLE_KEY=

# ML workspace root (host path bind-mounted into the api container)
WORKSPACE_ROOT=~/competitions

# LangSmith tracing — opt-in, off by default (design.md Observability Layer 3)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
